{
    "name": "getdkan/dkan",
    "type": "drupal-module",
    "description": "DKAN Open Data Catalog",
    "license": "GPL-2.0-or-later",
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "ext-json": "*",
        "drupal/facets": "^3.0.1",
        "drupal/moderated_content_bulk_publish": "~2.0.20",
        "drupal/search_api": "^1.15",
        "drupal/select2": "^2.0",
        "drupal/select_or_other": "^4.2.0",
        "drupal/views_bulk_operations": "^4.0",
        "ezyang/htmlpurifier": "^4.11",
        "fmizzell/maquina": "^1.1.1",
        "fylax/forceutf8": "^3.0",
        "getdkan/contracts": "^1.2.0",
        "getdkan/csv-parser": "^1.3.3",
        "getdkan/file-fetcher": "^5.1.0",
        "getdkan/pdlt": "^0.1.7",
        "getdkan/procrastinator": "^5.0.3",
        "getdkan/rooted-json-data": "^0.2.2",
        "guzzlehttp/guzzle": "^7.5",
        "ilbee/csv-response": "^1.2.0",
        "justinrainbow/json-schema": "^5.2 || ^6.6.1",
        "m1x0n/opis-json-schema-error-presenter": "^0.5.3",
        "ramsey/uuid": "^3.8.0 || ^4",
        "stolt/json-merge-patch": "^2.0"
    },
    "require-dev": {
        "composer/installers": "^1 || ^2",
        "drupal/core-composer-scaffold": "~10.5.0",
        "cweagans/composer-patches": "~1.0",
        "drupal/core-recommended": "~10.5.0",
        "drupal/core-dev": "~10.5.0",
        "php-parallel-lint/php-parallel-lint": "^1.2",
        "colinodell/psr-testlogger": "^1.2",
        "drush/drush": "*",
        "getdkan/mock-chain": "~1.4.1",
        "osteel/openapi-httpfoundation-testing": "^0.13",
        "drupal/admin_toolbar": "^3.0"
    },
    "conflict": {
        "phpunit/phpunit": ">=11.5.29 <11.5.31"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 36000,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "drupal/core-composer-scaffold": true,
            "drupalspoons/composer-plugin": true,
            "phpstan/extension-installer": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "audit": {
            "ignore": {
                "PKSA-yhcn-xrg3-68b1": "Drupal9.5 twig v2.15.4 to v2.15.6",
                "PKSA-2wrf-1xmk-1pky": "Drupal9.5 twig v2.15.4 to v2.15.6",
                "PKSA-6319-ffpf-gx66": "Drupal9.5 twig v2.15.4 to v2.15.6",
                "PKSA-365x-2zjk-pt47": "Drupal 11.1 symfony/http-foundation >=2 <=7.3.7. CVE-2025-64500",
                "PKSA-1gck-s111-yq7g": "Drupal 11.1 older versions of Composer < 2.9.3"
            }
        }
    },
    "extra": {
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "recipes/{$name}": [
                "type:drupal-recipe"
            ],
            "drush/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[project-root]/.gitattributes": {
                    "mode": "skip"
                }
            }
        },
        "drush": {
            "services": {
                "drush.services.yml": "^9 || ^10 || ^11"
            }
        },
        "dkan-frontend": {
            "ref": "1.3.0",
            "type": "vcs",
            "url": "https://github.com/GetDKAN/data-catalog-app"
        }
    },
    "authors": [
        {
            "name": "CivicActions",
            "email": "contact@civicactions.com"
        }
    ]
}