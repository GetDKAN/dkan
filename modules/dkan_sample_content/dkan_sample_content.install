<?php

/**
 * @file
 * Install file for the datastore_mysql_import module.
 */

/**
 * Disable legacy sample_content module.
 */
function dkan_sample_content_update_11301() {
  if (\Drupal::moduleHandler()->moduleExists('sample_content')) {
    \Drupal::service('module_installer')->uninstall(['sample_content']);
    return t('The legacy sample_content module has been uninstalled.');
  }
}
