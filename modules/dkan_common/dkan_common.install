<?php

/**
 * @file
 * Install, update and uninstall functions for the dkan_common module.
 */

/**
 * Implements hook_install().
 */
function dkan_common_install() {
  // If old common module is installed, copy setting
  // always_use_existing_local_perspective and uninstall.
  if (\Drupal::moduleHandler()->moduleExists('common')) {
    $config = \Drupal::configFactory()->getEditable('common.settings');
    $local_perspective = $config->get('always_use_existing_local_perspective');
    \Drupal::configFactory()->getEditable('dkan_common.settings')
      ->set('always_use_existing_local_perspective', $local_perspective)
      ->save();

    \Drupal::service('module_installer')->uninstall(['common']);
  }

}

/**
 * Update core.extension config to remove old common module.
 */
function dkan_common_update_10000(&$sandbox) {
  // Remove common.settings config if exists.
  if (\Drupal::configFactory()->get('common.settings')) {
    \Drupal::configFactory()->getEditable('common.settings')->delete();
  }

  $config = \Drupal::configFactory()->getEditable('core.extension');
  $modules = $config->get('module');
  if (isset($modules['common'])) {
    unset($modules['common']);
    $config->set('module', $modules);
    $config->save();
  }

}
