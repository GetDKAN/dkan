<?php

/**
 * @file
 * Install, update and uninstall functions for the dkan_datastore module.
 */

/**
 * Implements hook_install().
 */
function dkan_datastore_install() {
  // If old metastore module is installed, copy all metastore settings.
  if (\Drupal::moduleHandler()->moduleExists('datastore')) {
    $config = \Drupal::configFactory()->getEditable('datastore.settings');
    $settings = $config->getRawData();
    $new_config = \Drupal::configFactory()->getEditable('dkan_datastore.settings');
    foreach ($settings as $key => $value) {
      $new_config->set($key, $value);
    }
    $new_config->save();
  }

}
