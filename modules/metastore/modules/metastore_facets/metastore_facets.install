<?php

/**
 * @file
 * Install, update and uninstall functions for the metastore_search module.
 */

/**
 * Implements hook_install().
 */
function metastore_facets_install() {
  // Set the schema version to ensure update hook runs even on new install.
  \Drupal::service('update.update_hook_registry')->setInstalledVersion('metastore_facets', 9000);
  // If fresh 2.23 install: Run the update hook to enable the transitional module.
  metastore_facets_update_9001();
}

/**
 * Update hook to enable transitional dkan_metastore_facets module.
 */
function metastore_facets_update_9001() {
  if (!\Drupal::moduleHandler()->moduleExists('dkan_metastore_facets')) {
    \Drupal::service('module_installer')->install(['dkan_metastore_facets']);
  }

}
